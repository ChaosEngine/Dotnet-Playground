@{
	ViewData["Title"] = "nav.items.main.contact";
}
<h2>Contact</h2>

<h4>@Html.Raw(ViewData["Message"])</h4>

<address>
	<span id="spStreetName"></span><br />
	<span id="spCity"></span>, <span id="spState"></span> <span id="spZipCode"></span><br />
	<abbr title="Phone">P:</abbr>
	<span id="spPhone"></span>
</address>
<address>
	<strong>Support:</strong> <a id="aEmail0" href="#"></a>
</address>
<address>
	<strong>Marketing:</strong> <a id="aEmail1" href="#"></a>
</address>

@section Scripts
{
<environment include="Development">
	<script src="~/lib/chance/chance.min.js" type="text/javascript"></script>
</environment>
<environment exclude="Development">
	<script src="https://cdn.jsdelivr.net/npm/chance@1.1.13/dist/chance.min.js"
		integrity="sha256-XNg4f2HteQQm/WuPYzkZ223Z7fkMCGxHcJL8k5D3ed0=" crossorigin="anonymous"
		asp-fallback-src="~/lib/chance/chance.min.js" asp-fallback-test="window.chance"></script>
</environment>
<script type="text/javascript">
window.addEventListener('load', () => {
	document.getElementById('spStreetName').textContent = chance.street();
	document.getElementById('spCity').textContent = chance.city();
	document.getElementById('spState').textContent = chance.state();
	document.getElementById('spZipCode').textContent = chance.zip();
	document.getElementById('spPhone').textContent = chance.phone();
	const email0 = document.getElementById('aEmail0');
	email0.textContent = chance.email();
	email0.href = "mailto:" + email0.textContent;
	const email1 = document.getElementById('aEmail1');
	email1.textContent = chance.email();
	email1.href = "mailto:" + email1.textContent;
});
</script>
}