@inject  Microsoft.Extensions.Configuration.IConfiguration Conf
@{
	ViewData["Title"] = "nav.items.main.unintentional";
}
<h2>Unintentional Error</h2>
<h3>something from something with something of something</h3>
@{
	object tmp_val;
	if (TempData.TryGetValue("itwas", out tmp_val))
	{
		<p>@tmp_val</p>
	}
}

<form action="~/Home/UnintentionalErr" method="post">
	<input type="submit" name="action" value="repost" class="btn btn-primary" />
	<input type="submit" name="action" value="exception" class="btn btn-primary" />
</form>

<div class="row">
	<div class="col-auto">
		<h2>based on <a href="https://github.com/hishamco/jsLogger">jsLogger</a></h2>
		<p>Try to click the following buttons and keep your eyes on the default logger provider.</p>
		<p>
			<button class="btn btn-secondary js-log-trace" type="button">Log Trace</button>
			<button class="btn btn-secondary js-log-debug" type="button">Log Debug</button>
			<button class="btn btn-info js-log-info" type="button">Log Information</button>
			<button class="btn btn-warning js-log-warn" type="button">Log Warning</button>
			<button class="btn btn-danger js-log-error" type="button">Log Error</button>
		</p>
		<p>
			<button class="btn btn-danger js-throw-error" type="button">Throw Exception</button>
			<button class="btn btn-secondary" type="button" id="btnDelay" value="Delay">Intentional Delay</button>
		</p>
	</div>
</div>

@section scripts
{
<script type="text/javascript">
	function FireDelay() {

		$.ajax({
			method: "GET", url: "@Conf.AppRootPath()Home/UnintentionalErr/delay",
			timeout: 1000,
			success: function (response)
			{
				alert("success: " + response);
			},
			error: function (jqXHR, textStatus, errorThrown)
			{
				if (textStatus === "timeout") {
					alert("got timeout");
				} else {
					alert(textStatus);
				}
			}
		});
	}

	document.addEventListener('click', function (e) {
		const target = e.target;
		if (!(target instanceof Element)) {
			return;
		}

		if (target.closest('.js-log-trace')) {
			console.trace('This is a trace message.');
		}
		else if (target.closest('.js-log-debug')) {
			console.debug('This is a debug message.');
		}
		else if (target.closest('.js-log-info')) {
			console.info('This is a information message.');
		}
		else if (target.closest('.js-log-warn')) {
			console.warn('This is a warning message.');
		}
		else if (target.closest('.js-log-error')) {
			console.error('This is a error message.');
		}
		else if (target.closest('.js-throw-error')) {
			throw new Error('Unexpected Exception bum!!');
		}
		else if (target.closest('#btnDelay')) {
			FireDelay();
		}
	});
</script>
}
