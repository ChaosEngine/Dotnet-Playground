@{
	ViewBag.Title = "virtScrol.title";
}

<div id="toolbar" class="d-flex justify-content-between">
	<div>
		<button id="btninfo" class="btn btn-secondary me-2" type="button">&#9432; <span data-i18n="virtScrol.rowInfo">Row info</span></button>
		<span id="spStatus"></span>
	</div>
	<div>
		<label for="vsSearch" class="m-2 me-1" data-i18n="virtScrol.bootstrapTable.formatSearch">Search</label>
		<input id="vsSearch" type="search" class="form-control d-inline-block w-auto" autocomplete="off" />
		<button id="btnRefresh" class="btn btn-secondary mb-2" type="button" data-i18n='[aria-label]virtScrol.bootstrapTable.formatRefresh;[title]virtScrol.bootstrapTable.formatRefresh'>↻</button>
	</div>
</div>
<div class="position-relative border">
	<div id="virtualGridWrap" tabindex="0" role="region" aria-label="Virtual scroll grid" style="height: 60vh; overflow: auto; overflow-anchor: none">
		<div id="vsSpacerTop" aria-hidden="true"></div>
		<table id="table" class="table table-sm table-hover table-striped mb-0">
			<thead class="sticky-top z-2" style="top: -1px">
				<tr>
					<th class="bg-body-tertiary border">
						<button type="button" class="btn btn-link p-0 text-decoration-none fw-bold vs-sort" data-sort="key">
							<span data-i18n="virtScrol.key">Key</span>
							<span aria-hidden="true" class="vs-sort-indicator" data-col="key"></span>
						</button>
					</th>
					<th class="bg-body-tertiary border">
						<button type="button" class="btn btn-link p-0 text-decoration-none fw-bold vs-sort" data-sort="hashMD5">
							<span data-i18n="virtScrol.hashMD5">HashMD5</span>
							<span aria-hidden="true" class="vs-sort-indicator" data-col="hashMD5"></span>
						</button>
					</th>
					<th class="bg-body-tertiary border">
						<button type="button" class="btn btn-link p-0 text-decoration-none fw-bold vs-sort"
							data-sort="hashSHA256">
							<span data-i18n="virtScrol.hashSHA256">HashSHA256</span>
							<span aria-hidden="true" class="vs-sort-indicator" data-col="hashSHA256"></span>
						</button>
					</th>
					<th class="text-center bg-body-tertiary border">
						<button class="btn btn-success fw-bold text-nowrap pe-3 js-client-validate-all" title="Validate all" value="ValidateAll"
							data-i18n="[title]virtScrol.validateAllTitle;virtScrol.validateAll">ALL ⇩</button>
					</th>
				</tr>
			</thead>
			<tbody id="vsBody"></tbody>
		</table>
		<div id="vsSpacerBottom" aria-hidden="true"></div>
	</div>
	<div id="vsFooter" class="d-flex align-items-center justify-content-between gap-2 p-2 border-top bg-body-tertiary">
		<div class="d-flex align-items-center gap-2">
			<ul id="vsPaginationList" class="pagination mb-0" aria-label="Virtual grid pagination">
				<li id="liPrevPage" class="page-item">
					<button id="btnPrevPage" type="button" class="page-link"
						data-i18n='[aria-label]virtScrol.bootstrapTable.formatSRPaginationPreText;[title]virtScrol.bootstrapTable.formatSRPaginationPreText'>
						&lsaquo;
					</button>
				</li>
				<li id="liNextPage" class="page-item">
					<button id="btnNextPage" type="button" class="page-link"
						data-i18n='[aria-label]virtScrol.bootstrapTable.formatSRPaginationNextText;[title]virtScrol.bootstrapTable.formatSRPaginationNextText'>
						&rsaquo;
					</button>
				</li>
			</ul>
			<span id="spPageNumber"></span>
			<span id="spPageInfo"></span>
		</div>
		<div class="d-flex align-items-center gap-2">
			<label for="vsPageSize" class="mb-0" data-i18n="virtScrol.bootstrapTable.formatRecordsPerPage">Rows per page</label>
			<select id="vsPageSize" class="form-select w-auto">
				<option value="50">50</option>
				<option value="500">500</option>
				<option value="2000">2000</option>
				<option value="10000">10000</option>
			</select>
		</div>
	</div>
	<div id="vsLoadingOverlay" class="position-absolute top-0 start-0 w-100 h-100 d-none align-items-center justify-content-center bg-body bg-opacity-75 z-3">
		<div>
			<span id="vsLoadingMessage" class="fs-2 fw-semibold" data-i18n="virtScrol.bootstrapTable.formatLoadingMessage">Loading, please wait</span>
			<span class="spinner-grow spinner-grow-sm" role="status"></span>
			<span class="spinner-grow spinner-grow-sm" role="status" style="animation-delay: -0.4s;"></span>
			<span class="spinner-grow spinner-grow-sm" role="status" style="animation-delay: -0.6s;"></span>
		</div>
	</div>
</div>

@section scripts
{
	<environment include="Development">
		<script src="~/js/VirtualScroll.js" asp-append-version="true"></script>
	</environment>
	<environment exclude="Development">
		<script src="~/js/VirtualScroll.min.js" asp-append-version="true"></script>
	</environment>

	@await Html.PartialAsync("_CryptoJSScriptsPartial")
}
