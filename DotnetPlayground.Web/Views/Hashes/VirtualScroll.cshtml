@{
	ViewBag.Title = "virtScrol.title";
}

<div id="toolbar">
	<button id="btninfo" class="btn btn-secondary" type="button">&#9432;&nbsp;<span data-i18n="virtScrol.rowInfo">Row info</span></button>
	<button id="btnRefresh" class="btn btn-outline-secondary" type="button" data-i18n="virtScrol.bootstrapTable.formatRefresh">Refresh</button>
	<input id="txtSearch" type="search" class="form-control d-inline-block w-auto" placeholder="Search" style="max-width: 22rem;" />
	<select id="selPageSize" class="form-select d-inline-block w-auto" aria-label="Page size">
		<option value="50">50</option>
		<option value="500">500</option>
		<option value="2000">2000</option>
		<option value="10000">10000</option>
	</select>
	&nbsp;&nbsp;<span id="spStatus"></span>
</div>

<div class="container-fluid">
	<table id="table" class="table table-sm table-hover table-striped">
		<thead>
			<tr>
				<th data-sort-field="Key"><button type="button" class="btn btn-link p-0 text-decoration-none"><span data-i18n="virtScrol.key">Key</span></button></th>
				<th data-sort-field="HashMD5"><button type="button" class="btn btn-link p-0 text-decoration-none"><span data-i18n="virtScrol.hashMD5">HashMD5</span></button></th>
				<th data-sort-field="HashSHA256"><button type="button" class="btn btn-link p-0 text-decoration-none"><span data-i18n="virtScrol.hashSHA256">HashSHA256</span></button></th>
				<th>
					<button class="btn btn-success fw-bold text-nowrap pe-3" title="Validate all" value="ValidateAll" onclick="clientValidateAll()" data-i18n="[title]virtScrol.validateAllTitle;virtScrol.validateAll">ALL ⇩</button>
				</th>
			</tr>
		</thead>
		<tbody></tbody>
	</table>
	<div class="d-flex justify-content-between align-items-center mb-2">
		<button id="btnPrevPage" class="btn btn-outline-secondary" type="button">&larr;</button>
		<span id="spPageInfo"></span>
		<button id="btnNextPage" class="btn btn-outline-secondary" type="button">&rarr;</button>
	</div>
</div>

@section headElements
{
}
@section scripts
{
	<environment include="Development">
		<script src="~/js/VirtualScroll.js" asp-append-version="true"></script>
	</environment>
	<environment exclude="Development">
		<script src="~/js/VirtualScroll.min.js" asp-append-version="true"></script>
	</environment>

	@await Html.PartialAsync("_CryptoJSScriptsPartial")
}
